# ── LLM provider ───────────────────────────────────────────────────────
# digest.sh picks a provider automatically: --provider wins, then
# DIGEST_PROVIDER, then the first API key set below (openai, anthropic,
# openrouter), and finally LM Studio.
# DIGEST_PROVIDER=anthropic

# OpenAI (used by default, also by process.sh / newsletter.sh)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Model for digest.sh only, overriding the provider-specific *_MODEL above.
# digest.sh defaults to gpt-5.6-luna: 1.05M context, $0.20/$1.20 per 1M tokens,
# so even a 3-hour podcast is analyzed in a single pass.
# DIGEST_MODEL=gpt-5.6-luna

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter (one key, any model — prefix the model with its vendor)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# LM Studio / local model (used with --local, or --provider lmstudio)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=

# ── Discord bot (bot.sh) ───────────────────────────────────────────────
# From the Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# The bot refuses to start unless at least one of these is set: a run costs
# real money and CPU time, so it will not take orders from strangers.
# Enable Developer Mode in Discord to copy IDs via right-click.
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_ALLOWED_GUILDS=

# How results come back: files | gist | both
DIGEST_DELIVERY=files

# Needed for gist delivery; a fine-grained or classic token with 'gist' scope.
GITHUB_TOKEN=
# DIGEST_GIST_PUBLIC=false

# Bot-side run defaults and safety cap.
DIGEST_WHISPER_MODEL=base.en
DIGEST_THREADS=4
DIGEST_MAX_VIDEOS=25
