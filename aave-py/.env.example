# =============================================================================
# aave-py - environment template
# =============================================================================
# Same threat model as the TypeScript sibling project. See README.md for the
# full security warnings.
# =============================================================================

ALCHEMY_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# -----------------------------------------------------------------------------
# Signing
# -----------------------------------------------------------------------------
# mnemonic (default) = key derived in-process, unattended
# ledger             = key stays on the device, needs a button press per tx
#                      (install the extra: pip install -r requirements-ledger.txt)
# SIGNER=mnemonic

# 12 or 24 word BIP-39 phrase. Single line, single spaces between words.
# RECOMMENDED: leave this blank and pass --prompt to the CLI so the seed
# is never written to disk.
MNEMONIC=

# If you keep several seeds under namespaced keys (MNEMONIC_TREASURY, etc.),
# point the CLI at one instead of copying the phrase into MNEMONIC:
#   ./aave verify --mnemonic-var MNEMONIC_TREASURY
# MNEMONIC_VAR=

# BIP-39 passphrase, a.k.a. the "25th word". If your wallet uses one, every
# derived address changes -- omitting it silently yields a different, empty
# wallet. Prefer `--passphrase` to be prompted rather than storing it here.
# BIP39_PASSPHRASE=

HD_PATH=m/44'/60'/0'/0/0

# Used only when SIGNER=ledger. Falls back to HD_PATH if unset.
# LEDGER_PATH=m/44'/60'/0'/0/0

# Strongly recommended: the CLI aborts unless the resolved signer produces
# exactly this address. Cheapest guard there is against a wrong HD path, a
# forgotten passphrase, or the wrong mnemonic env var.
# EXPECTED_ADDRESS=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Withdraw
# -----------------------------------------------------------------------------
# Optional. Defaults to the wallet itself. Aave's withdraw() takes an arbitrary
# recipient, so setting this sends the underlying straight to its destination
# and skips a separate consolidation transfer entirely.
# RECIPIENT=0x0000000000000000000000000000000000000000

GAS_LIMIT=500000
# MAX_FEE_GWEI=200
PRIORITY_FEE_GWEI=2
AUTO_CONFIRM=false

# Aave leaves sub-cent rounding dust on accounts that have ever borrowed.
# Debt at or below this floor (USD scaled by 1e8) is ignored; anything above
# it aborts the drain unless you pass --allow-debt. Default 1000000 = $0.01.
# DEBT_DUST_THRESHOLD_BASE=1000000

# -----------------------------------------------------------------------------
# Swap (Curve 3pool consolidation)
# -----------------------------------------------------------------------------
# Max acceptable slippage against the on-chain get_dy quote, in basis points.
# 10 bps is ample for stables in a deep pool; tighter risks a revert.
# SLIPPAGE_BPS=10
# SWAP_GAS_LIMIT=400000
